{
    "name": "yaicess/innovation-conference-2025",
    "description": "YAICESS Innovation Conference 2025 Registration System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "razorpay/razorpay": "^2.8",
        "phpmailer/phpmailer": "^6.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'Dependencies installed successfully!'"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4"
        }
    }
}